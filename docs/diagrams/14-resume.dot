digraph G {graph [rankdir=TB,fontname="Helvetica",label="Exact diagnostic recovery",labelloc=t,pad=.3];node [shape=box,style="rounded,filled",fillcolor="#f1f6e8",fontname="Helvetica",fontsize=10];edge [fontname="Helvetica",fontsize=9];inputs [label="Frozen input bytes + numerical-source identity"]; init [label="Random initialization + sampler seed"]; epoch [label="Train one epoch"]; save [label="Atomic weights + moments + RNG + epoch checkpoint"]; interrupt [label="Process interruption"]; resume [label="Verify identities and restore complete state"]; result [label="Remaining epochs + unchanged completed outputs"]; check [label="Byte equality vs uninterrupted run
