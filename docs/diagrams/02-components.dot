digraph G { graph [rankdir=TB,bgcolor="white",fontname="Helvetica",label="Components and protocols",labelloc=t,pad=0.3,nodesep=0.3,ranksep=0.4]; node [shape=box,style="rounded,filled",fillcolor="#f1f6e8",color="#7e9568",fontname="Helvetica",fontsize=10,margin="0.15,0.1"]; edge [color="#637b52",fontname="Helvetica",fontsize=9]; ui [label="TypeScript DOM + EventSource"]; go [label="Go HTTP / SSE / CSV"]; worker [label="Python RPC child"]; engine [label="Domain engine + numerical reducer"]; db [label="SQLite WAL"]; ui -> go [label="same-origin HTTP / SSE"]; go -> worker [label="bounded JSON lines"]; worker -> engine [label="typed operation dispatch"]; engine -> db [label="one transaction"]; db -> go [label="durable stream query",style=dashed]; }
