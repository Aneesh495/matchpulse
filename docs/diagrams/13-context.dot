digraph G {graph [rankdir=TB,fontname="Helvetica",label="Sourced player context",labelloc=t,pad=.3];node [shape=box,style="rounded,filled",fillcolor="#f1f6e8",fontname="Helvetica",fontsize=10];edge [fontname="Helvetica",fontsize=9];source [label="Operator-owned source + canonical person"]; raw [label="Fact ID / revision / valid interval / known-at"]; validate [label="Rights declaration, expiry, kind and field validation"]; journal [label="Append-only context assertions"]; known [label="Select latest revision known by cutoff"]; valid [label="Filter valid time after selecting revision"]; view [label="History / comparison / registry panel
