digraph G { graph [rankdir=TB,bgcolor="white",fontname="Helvetica",label="Process ownership",labelloc=t,pad=0.3,nodesep=0.3,ranksep=0.4]; node [shape=box,style="rounded,filled",fillcolor="#f1f6e8",color="#7e9568",fontname="Helvetica",fontsize=10,margin="0.15,0.1"]; edge [color="#637b52",fontname="Helvetica",fontsize=9]; go [label="Go parent owns cancellation"]; admission [label="64 admitted calls maximum"]; gate [label="1 active worker call"]; python [label="Python child owns one SQLite connection"]; sqlite [label="SQLite owns durable commits"]; timeout [label="Deadline -> kill + wait child"]; go -> admission -> gate -> python -> sqlite; gate -> timeout [label="10 second API deadline"]; timeout -> python [label="next request starts new child"]; }
