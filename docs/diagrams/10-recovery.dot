digraph G { graph [rankdir=TB,bgcolor="white",fontname="Helvetica",label="Failure and replay recovery",labelloc=t,pad=0.3,nodesep=0.3,ranksep=0.4]; node [shape=box,style="rounded,filled",fillcolor="#f1f6e8",color="#7e9568",fontname="Helvetica",fontsize=10,margin="0.15,0.1"]; edge [color="#637b52",fontname="Helvetica",fontsize=9]; request [label="Unique normalized revision"]; journal [label="Journal append in transaction"]; fail [label="Exception / timeout / worker exit"]; rollback [label="Uncommitted state rolls back"]; restart [label="Worker restarts from same DB"]; retry [label="Retry same key"]; duplicate [label="Committed duplicate
no extra publication"]; request -> journal; journal -> fail -> rollback -> restart -> retry; retry -> duplicate [label="commit already existed"]; retry -> journal [label="previous transaction absent"]; }
