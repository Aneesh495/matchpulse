digraph G { graph [rankdir=TB,bgcolor="white",fontname="Helvetica",label="Bitemporal facts and atomic publication",labelloc=t,pad=0.3,nodesep=0.3,ranksep=0.4]; node [shape=box,style="rounded,filled",fillcolor="#f1f6e8",color="#7e9568",fontname="Helvetica",fontsize=10,margin="0.15,0.1"]; edge [color="#637b52",fontname="Helvetica",fontsize=9]; assertion [label="Identity alias
valid interval + known-at"]; envelope [label="Event journal
occurrence / publication / receipt"]; tx [label="BEGIN IMMEDIATE"]; snap [label="Immutable match snapshot vN"]; estimate [label="Estimate: person/match/version/model"]; outbox [label="Durable stream seq"]; commit [label="COMMIT all or ROLLBACK all"]; assertion -> envelope [label="canonical person"]; envelope -> tx -> {snap estimate outbox}; {snap estimate outbox} -> commit; }
